# Copy to .env.local for local development. Use the Supabase PostgreSQL connection string
# from Project Settings -> Database -> Connection string (URI). Never commit real credentials.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"
ADMIN_ACCESS_KEY="replace-with-a-long-random-secret"
